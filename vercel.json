{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/dashboard", "destination": "/pages/dashboard.html" },
    { "source": "/clients", "destination": "/pages/clients.html" },
    { "source": "/projects", "destination": "/pages/projects.html" },
    { "source": "/tasks", "destination": "/pages/tasks.html" },
    { "source": "/invoices", "destination": "/pages/invoices.html" },
    { "source": "/messages", "destination": "/pages/messages.html" },
    { "source": "/time-tracker", "destination": "/pages/time-tracker.html" },
    { "source": "/analytics", "destination": "/pages/analytics.html" },
    { "source": "/settings", "destination": "/pages/settings.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
